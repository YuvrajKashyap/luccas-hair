# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Square booking
# Replace when Tony Lucca's Square booking URL is available.
NEXT_PUBLIC_SQUARE_BOOKING_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional legacy fallback if the project still uses anon keys.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase key for contact and analytics persistence.
# Never expose this in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Admin access
# Comma-separated list of admin emails allowed to enter /admin after Supabase auth.
ADMIN_EMAIL_ALLOWLIST=tlucca65@yahoo.com
